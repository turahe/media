{
    "name": "turahe/media",
    "description": "Associate files with Eloquent models",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Wachid",
            "email": "nur@wach.id"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.9 || ^8.3",
        "kalnoy/nestedset": "^6.0.6 || ^7.0",
        "spatie/eloquent-sortable": "^5.0"
    },
    "require-dev": {
        "ext-imagick": "*",
        "laravel/pint": "^1.17",
        "league/flysystem-aws-s3-v3": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "php-ffmpeg/php-ffmpeg": "<0.6.1"
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Required to use AWS S3 file storage",
        "php-ffmpeg/php-ffmpeg": "Required for generating video thumbnails"
    },
    "autoload": {
        "psr-4": {
            "Turahe\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Turahe\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Turahe\\Media\\MediaServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse src tests",
        "baseline": "vendor/bin/phpstan analyse --generate-baseline",
        "pint": "vendor/bin/pint",
        "test": "vendor/bin/phpunit --testdox",
        "test:coverage": "vendor/bin/phpunit --coverage-clover=coverage.xml"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
